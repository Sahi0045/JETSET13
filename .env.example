# Firebase Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Firebase Emulator (for development)
VITE_USE_FIREBASE_EMULATOR=false
VITE_FIREBASE_EMULATOR_HOST=localhost
VITE_FIREBASE_EMULATOR_PORT=9099

# Existing environment variables
VITE_API_URL=http://localhost:3000/api
# Server-side ONLY — never use a VITE_ prefix here. Vite inlines VITE_* vars into
# the browser bundle, so a VITE_AMADEUS_CLIENT_SECRET would ship the GDS secret to
# every visitor. Amadeus calls are made server-side.
AMADEUS_CLIENT_ID=your_amadeus_client_id
AMADEUS_CLIENT_SECRET=your_amadeus_client_secret

# ---- Amadeus Enterprise Web Services (SOAP) - flights ----
# The WSAP, endpoint and credentials differ between the PDT test environment and
# production. Production values arrive from Amadeus only after certification.
# Switching environments is an edit to this file - nothing is hardcoded.
AMADEUS_WS_ENDPOINT=https://nodeD2.test.webservices.amadeus.com/1ASIWJETJEC
AMADEUS_WS_WSAP=1ASIWJETJEC
AMADEUS_WS_USERNAME=your_lss_user
AMADEUS_WS_PASSWORD=your_clear_password
AMADEUS_WS_OFFICE_ID=SCK1S2400
AMADEUS_WS_DUTY_CODE=SU
AMADEUS_WS_REQUESTOR_TYPE=U
# Operational switches
AMADEUS_WS_ENABLED=true              # kill switch: false = flights return a clean 503
AMADEUS_WS_BOOKING_ENABLED=false     # search first, booking after certification
AMADEUS_WS_AUTO_TICKET=false         # issue e-tickets in the booking chain (true in production)
AMADEUS_WS_QUEUE_NUMBER=50           # office queue for bookings awaiting manual ticketing
AMADEUS_WS_QUEUE_OFFICE=             # defaults to AMADEUS_WS_OFFICE_ID
AMADEUS_WS_FOP_CODE=CA               # form of payment recorded in the PNR (payment is via ARC Pay)
AMADEUS_WS_MAX_CONCURRENCY=15        # box-tuned for 2 vCPU/4 GB (single Node proc + Puppeteer/Redis co-resident). Raise to ~30-40 only after clustering Node + moving Puppeteer off. Never exceed the WSAP's max simultaneous sessions.
AMADEUS_WS_TIMEOUT_MS=25000
# How long a request may wait for a free Amadeus slot before giving up with
# a 503 + Retry-After. Bounded on purpose: an unbounded queue turns a slow
# Amadeus into a pile of timed-out requests holding sockets.
AMADEUS_WS_QUEUE_TIMEOUT_MS=8000
# Bookings (already paid) go ahead of searches for an Amadeus slot, and these
# slots are theirs alone so a search burst can never starve them. Default: a
# fifth of MAX_CONCURRENCY (15 -> 3).
AMADEUS_WS_BOOKING_RESERVED_SLOTS=3
# How long a booking waits for a slot before it is saved to the durable queue
# (booking row in Supabase, answered 202) and finished by the queue worker -
# instead of being refunded. Keep well under the ~30s Vercel proxy limit.
AMADEUS_WS_BOOKING_QUEUE_TIMEOUT_MS=10000
AMADEUS_WS_OFFER_MAX_AGE_MIN=30      # reject offers older than this at booking time
AMADEUS_WS_PRICE_TOLERANCE=0.00      # abort booking if the repriced fare differs by more
# Fraction of the priced fare the customer must have actually PAID (ARC capture)
# for the booking to ticket. The charge is client-supplied at checkout and never
# re-validated, so without this a tampered "$1" amount buys a full-price ticket.
# A ratio (not an exact match) because the charge also carries the admin service
# fee (up) and any coupon (down). Defaults to 0.8 when unset: clears the largest
# flight coupon (FLY20, 20% off). A booking with no payment on record is refused.
# Create a flight coupon worth more than 20% and you must lower this below
# (1 - discount), or those bookings are refused and refunded. 0 = disabled.
AMADEUS_WS_MIN_PAYMENT_RATIO=0.8
AMADEUS_WS_MAX_PASSENGERS_PER_PNR=9  # standard PNR cap (infants on lap excluded); 10+ is a group booking
# After issuing a ticket, the number takes a moment to appear in the PNR, so we
# wait then PNR_Retrieve, retrying a few times before leaving it for manual
# follow-up (Amadeus's reference ticketing flow). All non-fatal.
AMADEUS_WS_TICKET_RETRIEVE_INITIAL_MS=3000   # first wait before retrieving
AMADEUS_WS_TICKET_RETRIEVE_RETRIES=2         # extra retrieves after the first → 3 tries total (per the chart)
AMADEUS_WS_TICKET_RETRIEVE_DELAY_MS=1000     # wait between retries
AMADEUS_WS_CURRENCY=USD
AMADEUS_WS_LOG_ENVELOPES=false       # dev only; envelopes are redacted even when on
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ---- Server-side Supabase (used by the backend / API) ----
# The backend reads SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY (service role bypasses RLS).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
# Optional anon-key fallback if the service role key is not provided
SUPABASE_ANON_KEY=your_anon_key_here

# ---- Auth (agent JWTs) ----
# REQUIRED: there is no default — a missing/weak secret lets anyone forge tokens.
JWT_SECRET=generate_a_long_random_secret_here
JWT_EXPIRE=30d

# ARC Pay Gateway Configuration
# Obtain test credentials from: https://www2.arccorp.com/support/arc-pay/
# API Documentation: https://api.arcpay.travel/api/documentation/integrationGuidelines/index.html
# REQUIRED:
ARC_PAY_MERCHANT_ID=your_merchant_id_here
ARC_PAY_API_PASSWORD=your_api_password_here
ARC_PAY_BASE_URL=https://api.arcpay.travel/api/rest/version/77
# OPTIONAL — derived from ARC_PAY_BASE_URL/ARC_PAY_MERCHANT_ID when omitted:
#   ARC_PAY_API_URL           (default: <BASE_URL>/merchant/<MERCHANT_ID>)
#   ARC_PAY_CHECK_GATEWAY_URL (default: <BASE_URL>/information)
#   ARC_PAY_API_USERNAME      (default: <MERCHANT_ID>)
# ARC_PAY_PORTAL_URL=https://api.arcpay.travel/ma/
# Feature flags (default false):
# ARC_PAY_REAL_TIME=true
# ARC_PAY_PRODUCTION_READY_MODE=true
# Additional gateway passwords (optional):
# ARC_PAY_INTEGRATION_PASSWORD_1=...
# ARC_PAY_INTEGRATION_PASSWORD_2=...
# ARC_PAY_REPORTING_PASSWORD_1=...
# ARC_PAY_REPORTING_PASSWORD_2=...

# For testing, use test credentials from ARC
# Production credentials require approval from ARC
# Authentication: Basic HTTP Auth with merchant.<merchantId>:apiPassword

# Email Configuration (Resend)
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here
ADMIN_EMAIL=admin@yourcompany.com
FRONTEND_URL=http://localhost:3000

# Redis caching (optional but recommended for production stability/perf)
# When unset, caching is disabled and all calls pass through to the DB/APIs.
REDIS_URL=redis://localhost:6379
# Rate limiting (requests per minute per IP) — optional overrides
#
# Behind the Frankfurt host this is deliberately much higher (2000). Caddy
# replaces X-Forwarded-For with its immediate peer, which is Vercel's edge, so
# req.ip is shared by many visitors and per-IP limiting is coarse there. See
# deploy/README.md, "Why the rate limit is higher here than on Vercel".
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=30

# How many proxies sit in front of the app, for Express's `trust proxy`.
# Direct: 1. Behind Vercel -> Caddy -> app: 2. Setting it too high lets a
# client spoof its own address in X-Forwarded-For; too low and req.ip is the
# nearest proxy. It does not recover the real visitor IP behind Caddy either
# way — see the Caddyfile for why.
TRUST_PROXY_HOPS=1
# CORS allowlist — comma-separated origins (avoid "*" in production)
CORS_ORIGIN=http://localhost:5173,https://www.jetsetterss.com

# Error monitoring (Sentry) — optional; leave unset to disable
SENTRY_DSN=
VITE_SENTRY_DSN=
# Sampling 0..1 (0 = errors only, no performance traces)
SENTRY_TRACES_SAMPLE_RATE=0
VITE_SENTRY_TRACES_SAMPLE_RATE=0

# Slack incoming webhook for the operational alarms — optional, but note what
# goes quiet without it. Two jobs deliver through this and BOTH stay asleep when
# it is unset, saying so only once in the boot log:
#   - paid but never ticketed  (backend/jobs/needsReviewAlert.job.js)
#   - cancelled but never refunded (backend/jobs/paymentFailureAlert.job.js)
# Both announce money that is stuck, so an unset webhook means nobody is told
# that a customer paid and got nothing. Create one at
# https://api.slack.com/apps → Incoming Webhooks; it can post to exactly one
# channel and do nothing else.
ALERT_SLACK_WEBHOOK_URL=
# Global outbound HTTP timeout in ms (axios safety net)
HTTP_TIMEOUT_MS=30000

