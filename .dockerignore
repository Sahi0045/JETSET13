# Keep the build context small and, more importantly, keep secrets out of it.
# Anything listed here never reaches the daemon, so it cannot end up in a layer.

.env
.env.*
!.env.example
*.pem
*.key

node_modules
dist
.git
.github
.vercel
.claude
.commandcode
.kiro
.cursor

tests
coverage
docs
playstore-images
seo
resources
ds-bundle
supabase
database

npm-debug.log*
*.md
!README.md
