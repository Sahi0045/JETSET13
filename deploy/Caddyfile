# api.jetsetterss.com
#
# Caddy obtains and renews the Let's Encrypt certificate itself, so there is no
# certbot and no renewal cron. It needs port 80 reachable for the ACME HTTP
# challenge - that is why 80 stays open even though nothing is served on it.

{
	# Where Let's Encrypt sends expiry warnings if renewal ever stops working.
	email support@jetsetterss.com
}

api.jetsetterss.com {
	encode zstd gzip

	reverse_proxy app:5004 {
		# Deliberately NOT setting X-Forwarded-For here.
		#
		# Caddy REPLACES X-Forwarded-For with its immediate peer unless that peer
		# is listed in `trusted_proxies` - it will not take an untrusted upstream's
		# word for who the client is. Setting the header explicitly here would not
		# recover the visitor's address either; it would just make the intent
		# look deliberate.
		#
		# So `req.ip` in the app is a Vercel edge address, whatever TRUST_PROXY_HOPS
		# is set to. That is understood and compensated for rather than fixed:
		# trusting the incoming header would mean `trusted_proxies 0.0.0.0/0`,
		# since Vercel publishes no stable egress ranges for rewrites - and this
		# host is publicly reachable, so anyone could then forge the header
		# outright. See "Why the rate limit is higher here than on Vercel" in
		# deploy/README.md for what carries the load instead.

		# The booking chain is ten sequential GDS calls; a slow PDT response can
		# push a single request past a default 30 s. Generous here, because the
		# alternative is cutting off a request that is mid-booking.
		transport http {
			read_timeout 120s
			write_timeout 120s
		}
	}

	# The app already sets its own security headers; these are the transport-level
	# ones Caddy is better placed to add.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	log {
		output file /var/log/caddy/access.log {
			roll_size 20mb
			roll_keep 5
		}
		format json
	}
}
