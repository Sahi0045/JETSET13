{
  "private": true,
  "type": "module",
  "scripts": {
    "start": "NODE_ENV=production node server.js",
    "preview": "vite preview",
    "server": "nodemon server.js",
    "client": "vite",
    "dev": "node scripts/start-dev.js",
    "dev:legacy": "concurrently \"npm run server\" \"npm run client\" \"npm run supabase:check\"",
    "build": "NODE_ENV=production vite build && node scripts/copy-public-assets.js && node scripts/generate-route-seo-pages.js",
    "prod": "node scripts/start-prod.js",
    "prod:vercel": "vercel deploy --prod",
    "prod:setup": "node -e \"const fs = require('fs'); if(!fs.existsSync('.env.production')) { fs.copyFileSync('.env', '.env.production'); console.log('Created .env.production'); }\" && npm run build",
    "vercel-build": "npm run build",
    "postinstall": "npm install @vitejs/plugin-react vite --no-save || true",
    "supabase": "node scripts/start-app.js",
    "deploy": "npm run build && npm run start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:backend": "vitest run --project backend",
    "test:frontend": "vitest run --project frontend",
    "test:integration": "vitest run --project integration",
    "test:backend:watch": "vitest --project backend",
    "test:unit": "vitest run --project backend --project frontend",
    "build:prod": "NODE_ENV=production npm run build"
  },
